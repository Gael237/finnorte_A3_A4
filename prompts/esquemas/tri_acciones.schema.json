{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "acciones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descripcion": {
            "type": "string"
          },
          "runbook": {
            "type": "string",
            "pattern": "^rb-\\d{2}$"
          }
        },
        "required": ["descripcion", "runbook"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "faltantes": {
      "type": "string"
    }
  },
  "required": ["acciones", "faltantes"],
  "additionalProperties": false
}